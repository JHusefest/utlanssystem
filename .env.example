# Kopier denne filen til «.env» og fyll inn egne verdier før du kjører i drift.
# cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_USER=utlaan
POSTGRES_PASSWORD=bytt-dette-passordet
POSTGRES_DB=utlaan

# --- Sikkerhet --------------------------------------------------------------
# Lag en tilfeldig nøkkel, f.eks. med:  openssl rand -hex 32
SECRET_KEY=bytt-meg-til-en-lang-tilfeldig-streng
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Første administrator ---------------------------------------------------
# Opprettes automatisk første gang databasen er tom. Bytt passordet
# umiddelbart etter første innlogging (Min konto → Bytt passord).
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=bytt-meg-med-en-gang
FIRST_ADMIN_NAME=Administrator

# --- Nettverk ---------------------------------------------------------------
# Porten applikasjonen skal svare på utenfra.
APP_PORT=3000
